APP_NAME=FlixHN
APP_ENV=local
APP_KEY=base64:XG8d2m0qL1zOa8Pq3K9yN5wV8jR4eU1iB6tY7sA2dC0=
APP_DEBUG=true
APP_TIMEZONE=America/Tegucigalpa
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=flixhn
DB_USERNAME=flixhn_user
DB_PASSWORD=flixhn_secret
DB_ROOT_PASSWORD=root_secret

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DRIVER=cookie

# Puerto directo para streaming de video HLS/MP4
STREAM_PORT=7000
STREAM_BASE_URL=http://localhost:7000/media
# ==============================================================================
# FLIXGRAB ENGINE & PROGRESSIVE STREAMING CONFIGURATION
# ==============================================================================
# URL del microservicio daemon FlixGrab (Python)
FLIXGRAB_DAEMON_URL=http://127.0.0.1:8001
# Puerto de escucha del daemon FlixGrab
FLIXGRAB_PORT=8001
# Host de escucha (0.0.0.0 en producción / 127.0.0.1 en local)
FLIXGRAB_HOST=0.0.0.0
# Timeout de comunicación HTTP en segundos
FLIXGRAB_TIMEOUT=15
# Máximo de descargas simultáneas en cola
FLIXGRAB_MAX_CONCURRENT=3
# Espacio libre mínimo requerido en disco (Megabytes) antes de admitir nuevas descargas
FLIXGRAB_MIN_FREE_SPACE_MB=500
# Duración de cada segmento HLS en segundos para reproducción progresiva
FLIXGRAB_HLS_SEGMENT_DURATION=4
# Mínimo de segmentos HLS generados y validados antes de autorizar reproducción en caliente
FLIXGRAB_MIN_SEGMENTS_PLAY=2
# Ruta física del binario FFmpeg (dejar en 'ffmpeg' si está en PATH del sistema)
FFMPEG_PATH=ffmpeg
# Ruta física del binario FFprobe
FFPROBE_PATH=ffprobe
# Ruta del directorio de medios para almacenamiento físico
FLIXGRAB_STORAGE_PATH=/var/www/html/storage/media
# Ruta para manifiestos y fragmentos HLS en vivo
FLIXGRAB_HLS_PATH=/var/www/html/storage/media/hls_live
