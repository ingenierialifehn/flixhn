APP_NAME=FlixHN
APP_ENV=production
APP_KEY=base64:GENERA_TU_APP_KEY_CON_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://TU-SERVICIO-EN-RENDER.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

# CONEXIÓN TIDB CLOUD (AWS us-east-1)
DB_CONNECTION=mysql
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=flixhn
DB_USERNAME=oe9yMTDPC4cbAo3.root
DB_PASSWORD=TU_CONTRASENA_AQUI
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# SESIONES / CACHÉ / COLAS
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_DRIVER=file

# SEGURIDAD Y DOMINIOS DE PRODUCCIÓN
CORS_ALLOWED_ORIGINS=https://TU-SERVICIO-EN-RENDER.onrender.com,https://tu-dominio.com
SANCTUM_STATEFUL_DOMAINS=TU-SERVICIO-EN-RENDER.onrender.com
