APP_NAME=FlixHN
APP_ENV=local
APP_KEY=base64:ekQ3f/Sody1ONo82Wl+CfomzAOeaj45HYYRurVD8cnw=
APP_DEBUG=true
APP_TIMEZONE=America/Tegucigalpa
APP_URL=http://localhost
LOG_CHANNEL=stderr

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=flixhn
DB_USERNAME=flixhn_user
DB_PASSWORD=flixhn_secret

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173
SESSION_DRIVER=cookie
CACHE_STORE=file
QUEUE_CONNECTION=database

# almacenamiento y streaming
MEDIA_PATH=/var/media
MEDIA_URL=http://localhost:7000/media

# correo electrónico y notificaciones
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@flixhn.local"
MAIL_FROM_NAME="FlixHN Streaming"

# FlixGrab
FLIXGRAB_DAEMON_URL=http://127.0.0.1:8001
FLIXGRAB_PORT=8001
FLIXGRAB_HOST=0.0.0.0
FLIXGRAB_MAX_CONCURRENT=3
FLIXGRAB_MIN_FREE_SPACE_MB=500
FLIXGRAB_HLS_SEGMENT_DURATION=4
FLIXGRAB_MIN_SEGMENTS_PLAY=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
